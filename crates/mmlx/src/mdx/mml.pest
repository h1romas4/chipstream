document = { SOI ~ line* ~ EOI }

line = { title | pcmfile | voice | track | comment | block_comment | blank }

title = { ^"#title" ~ string ~ NEWLINE? }
pcmfile = { ^"#pcmfile" ~ string ~ NEWLINE? }

voice = {
	"@" ~ voice_number ~ "=" ~ "{" ~ voice_padding*
	~ voice_operator ~ voice_operator ~ voice_operator ~ voice_operator
	~ voice_global ~ voice_padding* ~ "}" ~ NEWLINE?
}
voice_operator = _{
	number ~ voice_separator ~ number ~ voice_separator ~ number ~ voice_separator
	~ number ~ voice_separator ~ number ~ voice_separator ~ number ~ voice_separator
	~ number ~ voice_separator ~ number ~ voice_separator ~ number ~ voice_separator
	~ number ~ voice_separator ~ number ~ voice_separator
}
voice_global = _{ number ~ voice_separator ~ number ~ voice_separator ~ number }
voice_separator = _{ "," ~ voice_padding* }
voice_padding = _{ block_comment | comment | NEWLINE }

track = { channel ~ command* ~ NEWLINE? }
channel = @{ 'A'..'H' | "P" }

command = _{
	block_comment
	| repeat
	| pitch_lfo_on | pitch_lfo_off | volume_lfo_on | volume_lfo_off
	| opm_lfo_on | opm_lfo_off
	| complex_note | complex_rest
	| opm_tempo | fine_gate | fine_volume | voice_select
	| pitch_lfo | volume_lfo | opm_lfo
	| tempo | note | numeric_note | rest | octave | octave_down | octave_up
	| default_length | gate | portamento | legato | volume | volume_down
	| volume_up | pan | loop_start | detune | loop_escape
	| register_write | key_on_delay | noise_frequency | sync_send | sync_wait
	| lfo_delay | ignore | pcm_frequency
}

repeat = { "[" ~ command* ~ "]" ~ repeat_count? }

tempo = { "t" ~ tempo_number }
opm_tempo = { "@t" ~ opm_tempo_number }
voice_select = { "@" ~ voice_number }
note = { note_name ~ accidental? ~ note_length_number? }
complex_note = { note_name ~ accidental? ~ length_expression }
note_name = @{ 'a'..'g' }
accidental = { "+" | "-" }
numeric_note = { "n" ~ note_number ~ ("," ~ duration)? }
rest = { "r" ~ note_length_number? }
complex_rest = { "r" ~ length_expression }
duration = { length_expression | number }
length_expression = { ("%" ~ number ~ ("^" ~ "%"? ~ number)*) | (number ~ ("^" ~ "%"? ~ number)+) }
octave = { "o" ~ octave_number }
octave_down = { "<" }
octave_up = { ">" }
default_length = { "l" ~ (length_expression | note_length_number) }
gate = { "q" ~ gate_number }
fine_gate = { "@q" ~ number }
portamento = { "_" }
legato = { "&" }
volume = { "v" ~ volume_number }
fine_volume = { "@v" ~ fine_volume_number }
volume_down = { "(" }
volume_up = { ")" }
pan = { "p" ~ pan_number }
loop_start = { "L" }
detune = { "D" ~ signed_number }
loop_escape = { "/" }
register_write = { "y" ~ byte_number ~ "," ~ byte_number }
key_on_delay = { "k" ~ number }
noise_frequency = { "w" ~ noise_number }
sync_send = { "S" ~ channel_ref }
sync_wait = { "W" }
pitch_lfo = { "MP" ~ number ~ "," ~ number ~ "," ~ number }
pitch_lfo_on = { "MPON" }
pitch_lfo_off = { "MPOF" }
volume_lfo = { "MA" ~ number ~ "," ~ number ~ "," ~ number }
volume_lfo_on = { "MAON" }
volume_lfo_off = { "MAOF" }
lfo_delay = { "MD" ~ number }
opm_lfo = { "MH" ~ number ~ "," ~ number ~ "," ~ number ~ "," ~ number ~ "," ~ number ~ "," ~ number ~ "," ~ number }
opm_lfo_on = { "MHON" }
opm_lfo_off = { "MHOF" }
ignore = { "!" }
pcm_frequency = { "F" ~ pcm_frequency_number }
number = @{ ASCII_DIGIT+ }
two_digits = { ASCII_DIGIT ~ ASCII_DIGIT }
three_digits = { ASCII_DIGIT ~ ASCII_DIGIT ~ ASCII_DIGIT }
byte_number = @{ "25" ~ ('0'..'5') | "2" ~ ('0'..'4') ~ ASCII_DIGIT | "1" ~ two_digits | two_digits | ASCII_DIGIT }
voice_number = { byte_number }
tempo_number = { number }
opm_tempo_number = { byte_number }
repeat_count = @{ "25" ~ ('0'..'5') | "2" ~ ('0'..'4') ~ ASCII_DIGIT | "1" ~ two_digits | two_digits | ('2'..'9') }
note_number = @{ "9" ~ ('0'..'5') | ('1'..'8') ~ ASCII_DIGIT | ('0'..'9') }
note_length_number = @{ three_digits | two_digits | ASCII_DIGIT }
octave_number = @{ '0'..'8' }
gate_number = @{ '1'..'8' }
volume_number = @{ "1" ~ ('0'..'5') | ('0'..'9') }
fine_volume_number = @{ "12" ~ ('0'..'7') | "1" ~ ('0'..'1') ~ ASCII_DIGIT | two_digits | ASCII_DIGIT }
pan_number = @{ '0'..'3' }
noise_number = @{ "3" ~ ('0'..'1') | ('1'..'2') ~ ASCII_DIGIT | ('0'..'9') }
pcm_frequency_number = @{ ('0'..'9') | "1" ~ ('0'..'2') }
signed_number = @{ "-"? ~ ASCII_DIGIT+ }
channel_ref = @{ 'A'..'H' | 'P'..'W' | number }

string = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
comment = { ";" ~ (!NEWLINE ~ ANY)* ~ NEWLINE? }
block_comment = { "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
blank = { NEWLINE }

NEWLINE = _{ "\r\n" | "\n" }
WHITESPACE = _{ " " | "\t" }